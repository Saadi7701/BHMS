# Production MongoDB Primary Cluster URI
MONGODB_PRODUCTION_URI="mongodb://localhost:27017/bilal_hospital_prod?retryWrites=true&w=majority"

# Backup MongoDB Secondary Cluster URI (Isolate from normal application queries)
MONGODB_BACKUP_URI="mongodb://localhost:27017/bilal_hospital_backup?retryWrites=true&w=majority"

# Server Port & Environment Configuration
PORT=3000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET="super-secret-jwt-key-change-in-production"
